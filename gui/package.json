{
  "name": "carrot-desktop",
  "version": "0.3.0",
  "description": "Carrot - A local-first AI assistant with speech, hybrid search, notes, and planning",
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "package": "electron-builder --dir",
    "dist": "electron-builder --publish=never"
  },
  "keywords": ["carrot", "ai", "assistant", "local", "ollama", "speech"],
  "author": "Carrot Community",
  "license": "MIT",
  "homepage": "https://github.com/ar3116-sketch/carrot",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.carrot.ai",
    "productName": "Carrot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/carrot-backend",
        "to": "backend/carrot-backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "extraResources": [
        {
          "from": "../assets/ollama-setup.exe",
          "to": "assets/ollama-setup.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/icon.png",
      "category": "Utility",
      "maintainer": "Carrot Community <carrot@users.noreply.github.com>"
    }
  }
}
